// DRP Rural Gestão - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

// Papéis globais do usuário na plataforma (RBAC de 3 níveis).
// - superadmin: administra toda a plataforma (não pertence a nenhuma organização)
// - gestor: administra a própria organização (fazenda/empresa rural)
// - colaborador: usuário operacional (agrônomo/técnico de campo)
enum UserRole {
  superadmin
  gestor
  colaborador
}

enum OrganizationStatus {
  active
  suspended
}

// Resultado de uma ação auditada.
enum AuditResult {
  success
  failure
}

// Ciclo de vida de uma evidência (arquivo) no fluxo de upload direto ao Storage.
// QUARANTINED    = rejeitado ANTES da expiração. Como o signed upload token pode
//                  continuar válido (P1/P5 não comprovados), o path pode ser reusado.
//                  NUNCA vira READY; sem URL; permanece acompanhado até uploadExpiresAt,
//                  quando o reconciliador faz a limpeza DEFINITIVA (→ CLEANING → FAILED).
// CLEANING       = limpeza EM ANDAMENTO (transição obrigatória antes de remover o
//                  objeto). NUNCA pode virar READY.
// FAILED         = autorização EXPIRADA e objeto removido/confirmado ausente (terminal).
// CLEANUP_FAILED = limpeza tentada MAS a remoção falhou (objeto pode existir → retry).
// DELETE_FAILED  = exclusão iniciada MAS a remoção falhou (objeto pode existir → retry).
// DELETED        = objeto removido/confirmado-ausente + deletedAt (terminal).
enum EvidenceStatus {
  UPLOADING
  READY
  FAILED
  QUARANTINED
  CLEANING
  CLEANUP_FAILED
  DELETING
  DELETE_FAILED
  DELETED
}

// Categoria derivada do CONTEÚDO validado (nunca escolhida pelo frontend).
enum EvidenceCategory {
  photo
  document
}

enum ProjectStatus {
  active
  paused
  completed
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskType {
  task
  order
}

enum DiagnosticStatus {
  draft
  completed
}

enum DiagnosticFormType {
  municipality_history
  drp_summary
  applied_methodology
  social_reality
  environmental_reality
  productive_vocations
  main_actions
  final_recommendations
}

enum LocalityType {
  community
  settlement
  village
  other
}

enum EvidenceType {
  photo
  video
  document
}

enum ScopeType {
  project
  municipality
  microregion
  locality
}

enum ProjectRole {
  manager
  agronomist
  local_manager
  operator
}

// ============================================
// MODELS
// ============================================

// ============================================
// MULTIEMPRESA (tenant raiz de todo o sistema)
// ============================================

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  document  String?            // CNPJ ou CPF do responsável (opcional)
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  // Relations
  users     User[]
  projects  Project[]
  auditLogs AuditLog[]
  evidences Evidence[]

  @@map("organizations")
}

model User {
  id            String    @id @default(uuid())
  // Organização à qual o usuário pertence.
  // Nulo apenas para superadmin (que atua acima das organizações).
  organizationId String?  @map("organization_id")
  email         String    @unique
  password      String
  fullName      String    @map("full_name")
  role          UserRole  @default(colaborador)
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  organization      Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectsCreated   Project[]       @relation("ProjectCreator")
  projectMembers    ProjectMember[]
  diagnosticsFilled Diagnostic[]
  tasksAssigned     Task[]          @relation("TaskAssignee")
  tasksCreated      Task[]          @relation("TaskCreator")
  evidencesUploaded Evidence[]
  auditLogs         AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  // Organização dona do projeto. Nulo apenas em dados legados anteriores
  // à introdução do multiempresa (serão preenchidos no backfill do seed).
  organizationId String?    @map("organization_id")
  name        String
  description String?
  status      ProjectStatus @default(active)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  createdById String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members        ProjectMember[]
  municipalities Municipality[]
  tasks          Task[]
  evidences      Evidence[]

  @@index([organizationId])
  @@map("projects")
}

model ProjectMember {
  id            String      @id @default(uuid())
  projectId     String      @map("project_id")
  userId        String      @map("user_id")
  roleInProject ProjectRole @default(operator) @map("role_in_project")
  scopeType     ScopeType   @default(project) @map("scope_type")
  scopeId       String?     @map("scope_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Municipality {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  name       String
  state      String   @db.VarChar(2)
  ibgeCode   String?  @map("ibge_code")
  population Int?
  areaKm2    Decimal? @map("area_km2") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  microregions Microregion[]
  diagnostics  Diagnostic[]

  @@map("municipalities")
}

model Microregion {
  id             String   @id @default(uuid())
  municipalityId String   @map("municipality_id")
  name           String
  description    String?
  familiesCount  Int?     @map("families_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  localities   Locality[]

  @@map("microregions")
}

model Locality {
  id            String       @id @default(uuid())
  microregionId String       @map("microregion_id")
  name          String
  localityType  LocalityType @default(community) @map("locality_type")
  latitude      Decimal?     @db.Decimal(10, 8)
  longitude     Decimal?     @db.Decimal(11, 8)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  microregion Microregion @relation(fields: [microregionId], references: [id], onDelete: Cascade)
  tasks       Task[]
  evidences   Evidence[]

  @@map("localities")
}

model Diagnostic {
  id             String             @id @default(uuid())
  municipalityId String             @map("municipality_id")
  formType       DiagnosticFormType @map("form_type")
  data           Json               @default("{}")
  status         DiagnosticStatus   @default(draft)
  filledById     String             @map("filled_by")
  filledAt       DateTime?          @map("filled_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Relations
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  filledBy     User         @relation(fields: [filledById], references: [id])
  evidences    Evidence[]

  @@unique([municipalityId, formType])
  @@map("diagnostics")
}

model Task {
  id           String       @id @default(uuid())
  projectId    String       @map("project_id")
  title        String
  description  String?
  taskType     TaskType     @default(task) @map("task_type")
  priority     TaskPriority @default(medium)
  status       TaskStatus   @default(pending)
  assignedToId String       @map("assigned_to")
  createdById  String       @map("created_by")
  dueDate      DateTime     @map("due_date")
  completedAt  DateTime?    @map("completed_at")
  localityId   String?      @map("locality_id")
  checklist    Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User       @relation("TaskCreator", fields: [createdById], references: [id])
  locality   Locality?  @relation(fields: [localityId], references: [id], onDelete: SetNull)
  evidences  Evidence[]

  @@map("tasks")
}

// Evidência = arquivo (foto/documento) armazenado no Supabase Storage.
// Nasce em UPLOADING (antes do upload); os campos validados (mimeType/fileSize/
// category/evidenceType) só são preenchidos na finalização, após inspeção do
// conteúdo real. A completude de READY é garantida por CHECK constraint no banco.
model Evidence {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  projectId      String            @map("project_id")
  status         EvidenceStatus    @default(UPLOADING)
  // Caminho interno no bucket (UUID gerado só no backend). Imutável. Não é segredo,
  // mas nunca aparece em respostas comuns, listagens, auditoria ou logs.
  storagePath    String            @unique @map("storage_path")

  // Tamanho ALEGADO no authorize — só para rejeição antecipada. Nunca substitui o real.
  declaredSize   Int?              @map("declared_size")

  // VALIDADOS (nullable durante UPLOADING; derivados do conteúdo na finalização)
  evidenceType   EvidenceType?     @map("evidence_type")
  category       EvidenceCategory?
  mimeType       String?           @map("mime_type")
  fileSize       Int?              @map("file_size")

  // Ciclo de vida
  uploadExpiresAt   DateTime? @map("upload_expires_at")
  readyAt           DateTime? @map("ready_at")
  deletedAt         DateTime? @map("deleted_at")
  reconcileLockedAt DateTime? @map("reconcile_locked_at")
  // Token único por execução do reconciliador (impede execução antiga de concluir
  // uma Evidence já re-reivindicada por outra execução).
  reconcileLockId   String?   @map("reconcile_lock_id")

  // Legado (deprecado, nullable — não gravamos mais)
  fileUrl        String?           @map("file_url")
  fileName       String?           @map("file_name")

  latitude       Decimal?          @db.Decimal(10, 8)
  longitude      Decimal?          @db.Decimal(11, 8)
  capturedAt     DateTime?         @map("captured_at")
  taskId         String?           @map("task_id")
  diagnosticId   String?           @map("diagnostic_id")
  localityId     String?           @map("locality_id")
  uploadedById   String            @map("uploaded_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Relations — Restrict em org/projeto/uploader (NUNCA Cascade → evita órfãos no Storage)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  diagnostic   Diagnostic?  @relation(fields: [diagnosticId], references: [id], onDelete: SetNull)
  locality     Locality?    @relation(fields: [localityId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([projectId, createdAt, id])
  @@index([status, uploadExpiresAt])
  @@index([status, reconcileLockedAt])
  @@map("evidences")
}

model AuditLog {
  id             String      @id @default(uuid())
  // Organização relacionada à ação (nula quando não se aplica — ex.: ações de
  // plataforma pelo superadmin). Vem SEMPRE do contexto/entidade, nunca do front.
  organizationId String?     @map("organization_id")
  // Usuário responsável — NULO quando não identificado (ex.: login recusado por
  // e-mail inexistente) ou ações de sistema.
  userId         String?     @map("user_id")
  action         String      // ex.: 'user.login_success', 'project.delete'
  entityType     String?     @map("entity_type") // ex.: 'User', 'Project'
  entityId       String?     @map("entity_id")
  result         AuditResult @default(success)
  // Marca acesso cross-org do superadmin (dado de uma org diferente da sua).
  crossOrg       Boolean     @default(false) @map("cross_org")
  ipAddress      String?     @map("ip_address")  // IP tratado/anonimizado no serviço
  userAgent      String?     @map("user_agent")
  metadata       Json?       // metadados JÁ sanitizados (sem segredos)
  oldData        Json?       @map("old_data")    // valores anteriores (sanitizados)
  newData        Json?       @map("new_data")    // valores posteriores (sanitizados)
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations:
  //  - organization: Restrict — organização NÃO pode ser apagada fisicamente
  //    (deve ser suspensa). Assim o vínculo histórico org↔log nunca se perde.
  //  - user: SetNull — proteção extra; o log jamais é apagado junto do usuário
  //    (na prática usamos desativação lógica, mas o SetNull garante o histórico).
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Índices orientados às consultas + PAGINAÇÃO POR CURSOR estável
  // (ordem: createdAt DESC, id DESC). O `id` como última coluna garante o
  // desempate no cursor sem duplicar/perder registros de mesmo createdAt.
  // Cada composto também cobre o filtro pelas colunas à esquerda (prefixo),
  // então não há índices simples redundantes.
  @@index([organizationId, createdAt, id])
  @@index([userId, createdAt, id])
  @@index([action, createdAt, id])
  @@index([result, createdAt, id])
  @@index([createdAt, id])                 // listagem global (superadmin)
  @@index([entityType, entityId, createdAt]) // histórico de uma entidade
  @@map("audit_logs")
}
