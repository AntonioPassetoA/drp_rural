# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/drp_rural?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_key_here_generate_with_openssl_rand_base64_32

# Segredo PRÓPRIO para assinar os cursores de auditoria (NÃO reutilizar NEXTAUTH_SECRET).
# Gere um valor forte (ex.: openssl rand -base64 32). Real fica no .env local e na Vercel.
AUDIT_CURSOR_SECRET=

# OpenAI (para IA)
OPENAI_API_KEY=your_openai_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase Storage (uploads de evidências via upload direto).
# PÚBLICAS (podem ir ao navegador / NEXT_PUBLIC_*):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# PRIVADAS (SERVER-ONLY — NUNCA no cliente, NUNCA NEXT_PUBLIC_*):
SUPABASE_SERVICE_ROLE_KEY=
# Config (server, não secreta; default 'evidences'):
SUPABASE_STORAGE_BUCKET=evidences

# Upload local (LEGADO/DEPRECADO — rota /api/upload responde 410; mantido só p/ compat)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ----------------------------------------------------------------------------
# Seed DEMONSTRATIVO (apenas desenvolvimento).
# Sem estas variáveis, o seed NÃO roda. Use senhas fortes, diferentes das reais.
# O seed é bloqueado automaticamente quando NODE_ENV=production.
# ----------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_AGRONOMIST_PASSWORD=
# ALLOW_DEMO_SEED=true   # (NÃO recomendado) força o seed mesmo em produção
